{
  "name": "akurganow-cv",
  "version": "1.0.0",
  "description": "Personal CV website with automated dependency management and release processes",
  "main": "index.jsx",
  "scripts": {
    "test": "jest",
    "start": "parcel src/index.html",
    "build:config": "cp src/_config.yml dist/_config.yml",
    "build:parcel": "parcel build src/index.html src/.well-known/**/* --no-source-maps --no-cache",
    "build": "npm-run-all build:parcel build:config",
    "clear": "rm -rf dist .cache",
    "gh-pages": "node ghpages.js",
    "deploy": "npm-run-all clear build gh-pages",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akurganow/akurganow.github.io.git"
  },
  "author": "Alexander Kurganov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Akurganow/akurganow.github.io/issues"
  },
  "homepage": "https://github.com/Akurganow/akurganow.github.io#readme",
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.0.0",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-prettier": "^3.1.3",
    "gh-pages": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "parcel": "^1.12.4",
    "postcss-preset-env": "^6.7.0",
    "posthtml-shorten": "^1.0.0",
    "prettier": "^2.0.5",
    "prettier-eslint": "^12.0.0",
    "release-it": "^19.0.4",
    "stylelint": "^13.4.0",
    "stylelint-config-standard": "^20.0.0"
  }
}
